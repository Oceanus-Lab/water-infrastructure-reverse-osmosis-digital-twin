config {
  type: "table",
  schema: "ro_curated",
  tags: ["curated", "daily"]
}

WITH dates AS (
  -- Generate a sequence of dates to ensure continuous coverage even if APIs have gaps
  SELECT date
  FROM UNNEST(GENERATE_DATE_ARRAY('2019-01-01', CURRENT_DATE())) AS date
),
-- Region filter is deliberately absent.
--
-- These were pinned to state_id = 'CA' because OCWD is in Fountain Valley, California. But
-- the EIA Total Energy bulk download has no state-level series at all (0 of its 2,210), so
-- load_eia_bulk.py writes state_id = 'US' and the filter silently produced zero rows — which
-- LAST_VALUE below then propagated as NULL across every date. Taking whatever region was
-- ingested keeps this working for both loaders; `state_id` is carried through to
-- environmental_context so a consumer can see whether it is looking at CA or a US proxy.
prices AS (
  SELECT date, state_id, electricity_cost_usd_per_kwh
  FROM ${ref("stg_eia_prices")}
),
carbon AS (
  SELECT date, grid_carbon_intensity_kg_per_kwh
  FROM ${ref("stg_eia_carbon")}
),
weather AS (
  SELECT date, ambient_temperature_c 
  FROM ${ref("stg_open_meteo")}
)
SELECT
  d.date,
  -- For prices and carbon, use LAST_VALUE to fill missing daily gaps from monthly data
  LAST_VALUE(p.electricity_cost_usd_per_kwh IGNORE NULLS) OVER (ORDER BY d.date) AS electricity_cost_usd_per_kwh,
  LAST_VALUE(c.grid_carbon_intensity_kg_per_kwh IGNORE NULLS) OVER (ORDER BY d.date) AS grid_carbon_intensity_kg_per_kwh,
  -- Carried through so a consumer can tell the local tariff from a national proxy.
  LAST_VALUE(p.state_id IGNORE NULLS) OVER (ORDER BY d.date) AS tariff_region,
  w.ambient_temperature_c
FROM dates d
LEFT JOIN prices p ON d.date = p.date
LEFT JOIN carbon c ON d.date = c.date
LEFT JOIN weather w ON d.date = w.date
