# Serving API (ro-serving-api). CLAUDE.md points here.
#
# NEXT_PUBLIC_* is inlined by `next build`, NOT read at runtime — setting this as a Cloud Run
# environment variable has no effect. For a deployed image pass it at build time:
#   gcloud run deploy ro-frontend --source . \
#     --set-build-env-vars NEXT_PUBLIC_API_URL=https://<serving-api-url>
#
# Left unset, the default is http://localhost:8000, which resolves on the *viewer's* machine.
# Every request then fails and the UI falls back to the mock generators in lib/data/ — the
# header shows a MOCK DATA badge when that happens.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Replay controller (services/replay), used by lib/store/replay-store.ts.
NEXT_PUBLIC_REPLAY_API_URL=http://localhost:8001
